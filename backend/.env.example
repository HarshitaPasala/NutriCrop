# Copy to backend/.env for local configuration.
# local_expert diagnoses curated examples only; custom uploads are inconclusive without a model.
VISION_MODEL_MODE=local_expert
VISION_MODEL_NAME=gemini-3.8-flash
VISION_MODEL_API_KEY=
# Optional deterministic demo: analyzes only the exact bundled fixture photos by SHA-256.
CROP_DOCTOR_MOCK=false
# Live custom image analysis: set VISION_MODEL_MODE=gemini and supply your private key.
